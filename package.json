{
  "name": "audio-guest-book-studio",
  "version": "1.0.0",
  "description": "Elegant desktop app for compiling wedding audio guest records into shareable visualizer videos",
  "license": "MIT",
  "author": {
    "name": "Edgars Kalniņš",
    "url": "https://github.com/EdgarsKalnins"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdgarsKalnins/audio-guest-book-studio.git"
  },
  "bugs": {
    "url": "https://github.com/EdgarsKalnins/audio-guest-book-studio/issues"
  },
  "homepage": "https://github.com/EdgarsKalnins/audio-guest-book-studio#readme",
  "keywords": [
    "audio guest book",
    "wedding audio guestbook",
    "audio visualizer",
    "sound wave video generator",
    "wedding video maker",
    "momentbox",
    "riga",
    "latvia",
    "fotokaste",
    "audio viesu gramata",
    "ffmpeg",
    "electron",
    "react"
  ],
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:app": "tsc && vite build && electron-builder",
    "test": "vitest run",
    "preview": "vite preview",
    "start": "electron ."
  },
  "build": {
    "appId": "com.audioguestbookstudio.app",
    "productName": "Audio Guest Book Studio",
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^1.16.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.1.0"
  }
}
